# Copia este archivo como .env y completa.
# Contraseña de la base de datos (inventa una larga).
DB_PASSWORD=cambia-esto-por-algo-largo
# Dirección pública (para los botones de los avisos y el feed de calendario).
URL_PUBLICA=https://juez.tudominio.cl
# Zona horaria (IANA).
ZONA_HORARIA=America/Santiago
# Nombre que aparece en la app.
NOMBRE=Juez del Tiempo
# Tema incluido si no montas uno propio en ./tema: neutro | noche
TEMA=neutro
# Puerto local (solo 127.0.0.1).
PUERTO=8080
# Opcional: crea la cuenta sin código de instalación.
# ADMIN_PASSWORD=
# Opcional: token del túnel de Cloudflare (docker compose --profile tunel up -d).
# TUNNEL_TOKEN=
