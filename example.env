# Veredicto · configuración de tu instalación.
# Copia este archivo como .env (el instalador lo hace solo). Nunca lo subas a GitHub.

# Versión de la imagen (mira las versiones en GitHub Releases). "latest" = la última.
VEREDICTO_VERSION=latest

# Carpeta donde vive TODO lo tuyo: base de datos, tema, notas, respaldos y clave de cifrado.
DATOS=./datos

# Contraseña de la base de datos. El instalador genera una larga al azar.
DB_PASSWORD=cambia-esto-por-algo-largo

# Clave para cifrar las credenciales de tus cuentas (Google, iCloud, Notion…).
# Si la dejas vacía, se crea sola en DATOS/clave/clave.key. Guárdala junto a tus respaldos.
CLAVE_CIFRADO=

# Dirección pública con https (para los botones de los avisos y para conectar Google/Outlook).
URL_PUBLICA=https://veredicto.tudominio.cl

# Zona horaria (IANA) y nombre que aparece en la app.
ZONA_HORARIA=America/Santiago
NOMBRE=Veredicto

# Tema incluido si no pones el tuyo en DATOS/tema/tema.css: neutro | noche
TEMA=neutro

# Puerto y dirección donde escucha (127.0.0.1 = solo este servidor; 0.0.0.0 = toda tu red).
PUERTO=8080
ESCUCHAR=127.0.0.1

# Usuario del sistema dueño de la carpeta DATOS (en Synology suele ser 1026:100).
PUID=1000
PGID=1000

# Cada cuántos minutos se sincronizan calendarios y notas.
SYNC_MINUTOS=2

# Opcional: crea la cuenta sin código de instalación.
# ADMIN_PASSWORD=

# Opcional: token del túnel de Cloudflare (docker compose --profile tunel up -d).
# TUNNEL_TOKEN=
